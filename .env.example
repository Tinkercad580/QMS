# Postgres connection string (Neon, Supabase, local, …)
DATABASE_URL=postgresql://username:password@host:5432/hms
PORT=3000

# SMS gateway (optional). If any of these are unset, SMS sending is skipped
# and the app logs a warning at startup instead of failing per message.
SMS_GATEWAY_URL=http://192.168.0.105:8080
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASSWORD=
